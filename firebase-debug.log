[debug] [2026-10-06T10:53:34.582Z] >>> [apiv2][body] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-no-project:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Default deny catch-all\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    // Admin role check: checks /admins collection or admin email\n    function isAdmin() {\n      return isSignedIn() && (\n        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||\n        (request.auth.token.email != null && request.auth.token.email == 'aslamhussain096@gmail.com')\n      );\n    }\n\n    // Admins collection:\n    match /admins/{adminId} {\n      allow get: if isSignedIn();\n      allow list, write: if isSignedIn();\n    }\n\n    // 1. Tournaments collection:\n    function isValidTournament(data) {\n      return data.title is string && data.title.size() <= 100 &&\n             data.entryFee is int && data.entryFee >= 0 &&\n             data.prizePool is int && data.prizePool >= 0 &&\n             data.totalSlots is int && data.totalSlots > 0 &&\n             data.filledSlots is int && data.filledSlots >= 0 &&\n             data.filledSlots <= data.totalSlots &&\n             (!('winnerName' in data) || (data.winnerName is string && data.winnerName.size() <= 100));\n    }\n\n    match /tournaments/{tournamentId} {\n      allow get, list: if isSignedIn();\n\n      allow create: if isSignedIn() && isValidId(tournamentId) && isValidTournament(incoming());\n\n      allow update: if isSignedIn() && isValidTournament(incoming()) && (\n        // Player Joining\n        (incoming().diff(existing()).affectedKeys().hasOnly(['filledSlots', 'statusText']) &&\n         incoming().filledSlots >= existing().filledSlots) ||\n        // Admin or update\n        incoming().diff(existing()).affectedKeys().hasOnly(['winnerName', 'statusText', 'title', 'map', 'scheduleTime', 'scheduleDate', 'entryFee', 'prizePool', 'perKill', 'totalSlots', 'filledSlots', 'bannerType', 'serverType', 'organizer', 'declaredWinnerAt'])\n      );\n\n      allow delete: if isAdmin();\n    }\n\n    // 2. User Profile:\n    function isValidUserProfile(data) {\n      return data.userId is string && data.userId == request.auth.uid &&\n             data.walletBalance is int && data.walletBalance >= 0 &&\n             (!('matchesPlayed' in data) || (data.matchesPlayed is int && data.matchesPlayed >= 0)) &&\n             (!('role' in data) || (data.role is string && (data.role == 'admin' || data.role == 'player'))) &&\n             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 60)) &&\n             (!('email' in data) || (data.email is string && data.email.size() <= 120));\n    }\n\n    match /users/{userId} {\n      allow get: if isOwner(userId) || isAdmin();\n      allow list: if isAdmin();\n\n      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());\n\n      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&\n                       incoming().userId == existing().userId;\n\n      allow delete: if isAdmin();\n\n      // 3. User Joined Registrations Subcollection:\n      function isValidRegistration(data) {\n        return data.userId is string && data.userId == request.auth.uid &&\n               data.tournamentId is string && data.tournamentId.size() <= 128 &&\n               data.entryFee is int && data.entryFee >= 0;\n      }\n\n      match /registrations/{registrationId} {\n        allow get, list: if isOwner(userId) || isAdmin();\n        allow create: if isOwner(userId) && isValidId(registrationId) && isValidRegistration(incoming());\n        allow update, delete: if isAdmin();\n      }\n\n      // 4. User Transactions Subcollection:\n      function isValidTransaction(data) {\n        return data.userId is string && data.userId == request.auth.uid &&\n               data.amount is int && data.amount > 0 &&\n               data.title is string && data.title.size() <= 150 &&\n               data.isCredit is bool;\n      }\n\n      match /transactions/{transactionId} {\n        allow get, list: if isOwner(userId) || isAdmin();\n        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());\n        allow update, delete: if isAdmin();\n      }\n    }\n  }\n}\n"}]}}
